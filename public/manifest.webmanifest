{
  "name": "Starry Night MPlayer",
  "short_name": "StarryMPlayer",
  "description": "Pemutar musik AI dengan tema luar angkasa",
  "id": "/starrynight-mplayer/",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone"
  ],
  "launch_handler": {
    "client_mode": ["navigate-new", "auto"]
  },
  "background_color": "#07071a",
  "theme_color": "#07071a",
  "orientation": "portrait",
  "categories": [
    "music",
    "entertainment"
  ],
  "lang": "id",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-192-maskable.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshot-mobile.png",
      "sizes": "390x844",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Starry Night MPlayer - Pemutar Musik"
    },
    {
      "src": "/screenshot-wide.png",
      "sizes": "1280x800",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Starry Night MPlayer - Desktop"
    }
  ],
  "shortcuts": [
    {
      "name": "Stream",
      "short_name": "Stream",
      "description": "Buka tab Stream & Radio",
      "url": "/?tab=stream&source=shortcut",
      "icons": [
        {
          "src": "/icon-192-maskable.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Playlist",
      "short_name": "Playlist",
      "description": "Buka koleksi & playlist",
      "url": "/?tab=playlist&source=shortcut",
      "icons": [
        {
          "src": "/icon-192-maskable.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Other",
      "short_name": "Other",
      "description": "Buka tab AI, lirik & fitur lain",
      "url": "/?tab=ai&source=shortcut",
      "icons": [
        {
          "src": "/icon-192-maskable.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "webapp",
      "url": "https://starrynight-mplayer.vercel.app/manifest.webmanifest",
      "id": "/starrynight-mplayer/"
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+starry",
      "url": "/?intent=%s"
    },
    {
      "protocol": "web+starryplay",
      "url": "/?play=%s"
    },
    {
      "protocol": "web+starryradio",
      "url": "/?tab=stream&station=%s"
    }
  ]
}
