{
  "name": "Starry Night MPlayer",
  "short_name": "StarryMPlayer",
  "description": "Pemutar musik AI dengan tema luar angkasa",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "background_color": "#07071a",
  "theme_color": "#07071a",
  "orientation": "any",
  "categories": ["music", "entertainment"],
  "lang": "id",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Radio",
      "short_name": "Radio",
      "description": "Buka tab Radio langsung",
      "url": "/?tab=stream",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Koleksi",
      "short_name": "Koleksi",
      "description": "Lihat koleksi & playlist",
      "url": "/?tab=playlist",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "AI & Lirik",
      "short_name": "AI",
      "description": "Buka tab AI & lirik",
      "url": "/?tab=ai",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    }
  ],
  "prefer_related_applications": false
}
