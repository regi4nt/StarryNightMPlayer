{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "functions": {
    "api/openai.js": {},
    "api/anthropic.js": {},
    "api/openrouter.js": {},
    "api/gemini.js": {},
    "api/groq.js": {},
    "api/deepseek.js": {},
    "api/grok.js": {},
    "api/huggingface.js": {},
    "api/cloudflare.js": {},
    "api/github.js": {},
    "api/sambanova.js": {},
    "api/spotify-token.js": {},
    "api/soundcloud.js": {}
  },
  "rewrites": [
    {
      "source": "/api/radio-garden/:path*",
      "destination": "https://radio.garden/api/ara/:path*"
    },
    {
      "source": "/api/chartlyrics/:path*",
      "destination": "http://api.chartlyrics.com/apiv1.asmx/:path*"
    },
    {
      "source": "/api/textyl/:path*",
      "destination": "https://api.textyl.co/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}