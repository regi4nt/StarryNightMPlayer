{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/api/radio-garden/:path*",
      "destination": "https://radio.garden/api/ara/:path*"
    },
    {
      "source": "/api/chartlyrics/:path*",
      "destination": "http://api.chartlyrics.com/apiv1.asmx/:path*"
    },
    {
      "source": "/api/textyl/:path*",
      "destination": "https://api.textyl.co/api/:path*"
    },
    {
      "source": "/api/jamendo",
      "destination": "https://api.jamendo.com/v3.0/tracks/?client_id=b6747d04&format=json&include=musicinfo&audioformat=mp32"
    },
    {
      "source": "/api/ccmixter",
      "destination": "https://ccmixter.org/api/query?f=json"
    },
    {
      "source": "/api/deezer",
      "destination": "https://api.deezer.com/search"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
